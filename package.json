{
  "name": "locator-repair-agent",
  "version": "0.1.0",
  "description": "Triages Playwright/Cucumber failures, proposes locator fixes, verifies them, and opens a single pull request.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "locator-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.696.0",
    "@octokit/rest": "^21.0.2",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "domhandler": "^5.0.3",
    "fast-glob": "^3.3.2",
    "ts-morph": "^24.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
